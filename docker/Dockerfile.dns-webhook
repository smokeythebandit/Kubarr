# syntax=docker/dockerfile:1.4
FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY code/dns-webhook/go.mod code/dns-webhook/go.sum ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY code/dns-webhook ./
RUN --mount=type=cache,id=go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOOS=linux go build -mod=mod -o /kubarr-dns-webhook .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
USER 1000:1000
COPY --from=builder /kubarr-dns-webhook /kubarr-dns-webhook
ENTRYPOINT ["/kubarr-dns-webhook"]
