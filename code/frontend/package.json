{
  "name": "kubarr",
  "private": true,
  "version": "0.3.1",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.34.3"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 100",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --config playwright.browser.config.ts",
    "test:real": "playwright test --config playwright.real.config.ts",
    "test:acceptance": "playwright test --config playwright.real.config.ts",
    "test:typecheck": "tsc --project tsconfig.tests.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "clsx": "^2.0.0",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "otpauth": "^9.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "form-data": "^4.0.6",
      "flatted": "^3.4.2",
      "lodash": "^4.18.1"
    }
